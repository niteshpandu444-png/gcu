# Copy to .env and adjust values. All values below are the defaults.
APP_NAME=GCU
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///./gcu.db
JWT_SECRET=gcu-hackathon-dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Comma separated list, or * for any origin
CORS_ORIGINS=*

# OpenAI-compatible LLM (optional — leave LLM_API_KEY empty to use the
# deterministic fallback, which keeps the demo working without network access)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15
